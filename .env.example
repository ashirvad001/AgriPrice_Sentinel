# ===============================================================================
#  AgriPrice Sentinel - Environment Variables
# ===============================================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# Database
DATABASE_URL=
DB_POOL_SIZE=
DB_MAX_OVERFLOW=
DB_POOL_RECYCLE=

# Redis (caching & Celery broker)
REDIS_URL=

# JWT Authentication
SECRET_KEY=
JWT_ALGORITHM=
JWT_EXPIRE_MINUTES=

# Twilio (WhatsApp alerts)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_TEMPLATE_SID=

# Agmarknet / data.gov.in (price scraper)
DATAGOV_API_KEY=

# OpenWeatherMap (weather scraper)
OPENWEATHER_API_KEY=

# MLflow (model tracking & registry)
MLFLOW_TRACKING_URI=

# Mandi Dataset
MANDI_DATASET_PATH=

# CORS
CORS_ORIGINS=

# Slack (optional)
SLACK_WEBHOOK_URL=

# App Config
PORT=
LOG_LEVEL=
